# Cloudflare Pages 响应头配置（2026-10-30）
#
# 目的：页面壳可缓存、数据不可缓存。
#   以前页面是 max-age=0，每次都要回源拉 939KB —— pages.dev 一抖就打不开。
#   现在页面壳缓存 10 分钟 + 过期后 stale-while-revalidate（先用旧的秒开，
#   后台再验证），TLS 抖动时完全感觉不到。
#
# 注意：数据 JSON 不在这里（它们走 SCF → D1 实时接口，不经过 Pages 静态）。

/
  Cache-Control: public, max-age=600, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: public, max-age=600, stale-while-revalidate=604800
  Content-Type: text/html; charset=utf-8

/v2
  Cache-Control: public, max-age=600, stale-while-revalidate=604800
  Content-Type: text/html; charset=utf-8

/manifest.json
  Cache-Control: public, max-age=300
  Content-Type: application/manifest+json; charset=utf-8

# Service Worker 绝不能缓存：旧 SW 会让用户永远停在旧逻辑上
/sw.js
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# 图标与 manifest 只缓存 5 分钟：曾经 icon-512.png 给的是 192×192 的假图，
# 7 天 immutable 会把错误钉死在用户设备上（PWA 因此判图标无效、装不了）。
/*.png
  Cache-Control: public, max-age=300
